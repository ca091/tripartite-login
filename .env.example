# Third-party login configuration. Keep each provider section independent.
# Google
# Public client ID; no Google client secret is used by this demo.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
# Show One Tap when ready; automatic sign-in stays disabled.
NUXT_PUBLIC_GOOGLE_ONE_TAP_ENABLED=false

# Apple
# Public client settings plus server-only signing credentials.
NUXT_PUBLIC_APPLE_CLIENT_ID=com.YunFang.PhotoGrid.SignInWithApple
NUXT_PUBLIC_APPLE_REDIRECT_URI=https://www.photogrid.app
NUXT_APPLE_TEAM_ID=
NUXT_APPLE_KEY_ID=
NUXT_APPLE_PRIVATE_KEY=

# GitHub
# Public client settings plus the server-only OAuth secret.
NUXT_PUBLIC_GITHUB_CLIENT_ID=
NUXT_PUBLIC_GITHUB_REDIRECT_URI=
NUXT_GITHUB_CLIENT_SECRET=

# Microsoft (personal accounts only)
# Register a Single-page application redirect; no client secret is required.
NUXT_PUBLIC_MICROSOFT_CLIENT_ID=
# Empty derives the current origin + /auth/callback-microsoft.
NUXT_PUBLIC_MICROSOFT_REDIRECT_URI=
